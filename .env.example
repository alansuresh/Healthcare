# Firebase configuration
# Copy to `.env` and fill in values from your Firebase project console.
# If left blank, the app falls back to a local demo auth provider so the
# UI can still be reviewed without a Firebase project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
